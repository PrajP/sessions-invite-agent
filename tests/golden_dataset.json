{
  "description": "Golden evaluation dataset for Autonomous Payment Reconciliation & Session Enrollment Agent",
  "version": "1.0.0",
  "pass_threshold": 0.90,
  "cases": [
    {
      "case_id": "case_01_direct_upi_match",
      "description": "Direct UPI payment match for Level 1 session with matching applicant name",
      "input": {
        "form_entry_id": "ROW-101",
        "applicant_name": "Aarav Sharma",
        "applicant_email": "aarav.sharma@example.com",
        "applicant_phone": "+919876543210",
        "session_level": 1,
        "receipt_image_base64": "402819283741"
      },
      "expected_output": {
        "status": "ENROLLED",
        "is_payment_verified": true,
        "requires_hitl": false
      }
    },
    {
      "case_id": "case_02_family_upi_payer_hitl",
      "description": "Payment made by uncle/family member with different name on UPI receipt",
      "input": {
        "form_entry_id": "ROW-102",
        "applicant_name": "Rohit Kumar",
        "applicant_email": "rohit.k@example.com",
        "applicant_phone": "+919876543211",
        "session_level": 2,
        "receipt_image_base64": "409988776655"
      },
      "expected_output": {
        "status": "AWAITING_HUMAN_APPROVAL",
        "is_payment_verified": true,
        "requires_hitl": true
      }
    },
    {
      "case_id": "case_03_paypal_usd_direct_match",
